{
  "name": "@psicodesk/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test src/api/backoff.test.ts src/api/client.test.ts src/api/config.test.ts src/auth/deviceCleanup.test.ts src/auth/provisioningValidation.test.ts src/database/projectionMaterializer.test.ts src/security/base64.test.ts src/security/batchSigning.test.ts src/sync/BatchEngine.test.ts",
    "test:integration": "npm run build --workspace @psicodesk/api && node --experimental-transform-types --test src/integration/api.e2e.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-router": "58.0.29",
    "expo-linking": "58.0.15",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
