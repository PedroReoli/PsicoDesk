{
  "expo": {
    "name": "PsicoDesk",
    "slug": "psicodesk-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "psicodesk",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f7f6"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permita ao PsicoDesk proteger o acesso aos dados da clínica."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.psicodesk.mobile",
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.psicodesk.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#087f70" },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "experiments": { "typedRoutes": true },
    "extra": { "apiUrl": "" }
  }
}
