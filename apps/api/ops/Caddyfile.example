{
  admin off
  email {$ACME_EMAIL}
}

{$API_DOMAIN} {
  encode zstd gzip

  request_body {
    max_size 28MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  reverse_proxy api:8787

  log {
    output stdout
    format json
  }
}
