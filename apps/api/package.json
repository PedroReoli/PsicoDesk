{
  "name": "@psicodesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@fastify/jwt": "10.2.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/websocket": "11.3.6",
    "@psicodesk/sync-protocol": "0.1.0",
    "@smithy/node-http-handler": "4.14.1",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pg": "8.23.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
